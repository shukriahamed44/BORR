{
	"info": {
		"_postman_id": "ammunation-erp-inventory-subcollection",
		"name": "AmmuNation ERP - Inventory Logs Domain Module",
		"description": "Postman Collection v2.1 for Warehouse Inventory Audit Logs endpoints.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000/api/v1",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "productId",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Log Stock Receipt (RECEIVE stock)",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{accessToken}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"productId\": \"{{productId}}\",\n  \"action\": \"RECEIVE\",\n  \"quantity\": 10,\n  \"notes\": \"Received new stock batch from supplier.\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/inventory/logs",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"inventory",
						"logs"
					]
				}
			}
		},
		{
			"name": "2. Log Damage Record (DAMAGE_RECORDED)",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{accessToken}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"productId\": \"{{productId}}\",\n  \"action\": \"DAMAGE_RECORDED\",\n  \"quantity\": 1,\n  \"notes\": \"Lens cracked during field operation #102.\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/inventory/logs",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"inventory",
						"logs"
					]
				}
			}
		},
		{
			"name": "3. List Inventory Action Logs",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{accessToken}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/inventory/logs",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"inventory",
						"logs"
					]
				}
			}
		},
		{
			"name": "4. Get Product Audit History",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{accessToken}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/inventory/logs/product/{{productId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"inventory",
						"logs",
						"product",
						"{{productId}}"
					]
				}
			}
		}
	]
}
