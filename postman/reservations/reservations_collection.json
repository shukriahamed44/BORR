{
	"info": {
		"_postman_id": "ammunation-erp-reservations-subcollection",
		"name": "AmmuNation ERP - Reservations Domain Module",
		"description": "Postman Collection v2.1 for Reservation Transaction State Machine endpoints.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000/api/v1",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "productId",
			"value": "",
			"type": "string"
		},
		{
			"key": "reservationId",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Create Reservation (PENDING state)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.reservation && jsonData.reservation.id) {",
							"    pm.collectionVariables.set('reservationId', jsonData.reservation.id);",
							"    console.log('ReservationId auto-saved:', jsonData.reservation.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{accessToken}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"startDate\": \"2026-08-10T09:00:00.000Z\",\n  \"endDate\": \"2026-08-15T18:00:00.000Z\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/reservations",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"reservations"
					]
				}
			}
		},
		{
			"name": "2. List Reservations",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{accessToken}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/reservations",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"reservations"
					]
				}
			}
		},
		{
			"name": "3. Get Reservation Details",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{accessToken}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/reservations/{{reservationId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"reservations",
						"{{reservationId}}"
					]
				}
			}
		},
		{
			"name": "4. Approve Reservation (STAFF or ADMIN only)",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{accessToken}}",
							"type": "string"
						}
					]
				},
				"method": "PATCH",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"status\": \"APPROVED\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/reservations/{{reservationId}}/status",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"reservations",
						"{{reservationId}}",
						"status"
					]
				}
			}
		},
		{
			"name": "5. Checkout Equipment (Transition APPROVED -> ACTIVE)",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{accessToken}}",
							"type": "string"
						}
					]
				},
				"method": "PATCH",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"status\": \"ACTIVE\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/reservations/{{reservationId}}/status",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"reservations",
						"{{reservationId}}",
						"status"
					]
				}
			}
		},
		{
			"name": "6. Return Equipment (Transition ACTIVE -> RETURNED)",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{accessToken}}",
							"type": "string"
						}
					]
				},
				"method": "PATCH",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"status\": \"RETURNED\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/reservations/{{reservationId}}/status",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"reservations",
						"{{reservationId}}",
						"status"
					]
				}
			}
		}
	]
}
