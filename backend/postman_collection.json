                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin.alex@ammunation.com\",\n  \"password\": \"Password123!\",\n  \"name\": \"Commander Alex\",\n  \"role\": \"ADMIN\"\n}"
